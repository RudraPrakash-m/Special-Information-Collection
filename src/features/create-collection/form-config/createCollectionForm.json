[
  {
    "name": "surveyId",
    "label": "Data Capture Survey",
    "type": "select",
    "placeholder": "- Select Survey -",
    "gridColumn": 3,
    "required": true,
    "validation": {
      "required": true,
      "message": "Data Capture Survey is mandatory"
    }
  },
  {
    "name": "collectionTitle",
    "label": "Collection Title",
    "type": "text",
    "placeholder": "Enter collection title (max 200 characters)",
    "gridColumn": 3,
    "maxLength": 200,
    "required": true,
    "validation": {
      "required": true,
      "message": "Collection Title is mandatory"
    }
  },
  {
    "name": "collectionType",
    "label": "Collection Type",
    "type": "radio-group",
    "gridColumn": 3,
    "orientation": "horizontal",
    "required": true,
    "options": [
      { "label": "Institution-specific", "value": "institution" },
      { "label": "Scheme-specific", "value": "scheme" },
      { "label": "Activity-specific", "value": "activity" }
    ],
    "validation": {
      "required": true,
      "message": "Collection Type is mandatory"
    }
  },
  {
    "name": "scheme",
    "label": "Scheme",
    "type": "select",
    "placeholder": "- Select Scheme -",
    "gridColumn": 3,
    "required": true,
    "options": [],
    "validation": {
      "required": true,
      "message": "Scheme is mandatory for a Scheme-specific collection"
    }
  },
  {
    "name": "activityName",
    "label": "Activity Name",
    "type": "text",
    "placeholder": "Enter activity name",
    "gridColumn": 3,
    "maxLength": 200,
    "required": true,
    "validation": {
      "required": true,
      "message": "Activity Name is mandatory for an Activity-specific collection"
    }
  },
  {
    "name": "orderReference",
    "label": "Order / Letter Reference",
    "type": "text",
    "placeholder": "Order/letter ref no.",
    "gridColumn": 3,
    "maxLength": 100
  },
  {
    "name": "referenceDocument",
    "label": "Reference Document",
    "type": "file",
    "gridColumn": 3,
    "accept": ".pdf"
  },
  {
    "name": "frequency",
    "label": "Frequency",
    "type": "select",
    "placeholder": "- Select -",
    "gridColumn": 3,
    "required": true,
    "options": [
      { "label": "One-time", "value": "one-time" },
      { "label": "Monthly", "value": "monthly" },
      { "label": "Quarterly", "value": "quarterly" },
      { "label": "Half-yearly", "value": "half-yearly" },
      { "label": "Yearly", "value": "yearly" }
    ],
    "validation": {
      "required": true,
      "message": "Frequency is mandatory"
    }
  },
  {
    "name": "cycleDurationDays",
    "label": "Cycle Duration (Days)",
    "type": "number",
    "placeholder": "Days (1-60)",
    "gridColumn": 3,
    "min": 1,
    "max": 60,
    "required": true,
    "validation": {
      "required": true,
      "message": "Cycle Duration is mandatory for a recurring collection"
    }
  },
  {
    "name": "recurrenceEndDate",
    "label": "Recurrence End Date",
    "type": "date",
    "gridColumn": 3
  },
  {
    "name": "approvalRequired",
    "label": "Approval Required",
    "type": "radio-group",
    "gridColumn": 3,
    "orientation": "horizontal",
    "required": true,
    "options": [
      { "label": "Yes", "value": "yes" },
      { "label": "No", "value": "no" }
    ],
    "validation": {
      "required": true,
      "message": "Approval Required is mandatory"
    }
  },
  {
    "name": "allowReturnForCorrection",
    "label": "Allow Return for Correction",
    "type": "checkbox",
    "gridColumn": 3
  },
  {
    "name": "correctionPeriodDays",
    "label": "Correction Period (Days)",
    "type": "number",
    "placeholder": "Days (1-30)",
    "gridColumn": 3,
    "min": 1,
    "max": 30,
    "required": true,
    "validation": {
      "required": true,
      "message": "Correction Period is mandatory"
    }
  },
  {
    "name": "allowOfflineUpload",
    "label": "Allow Offline Upload",
    "type": "checkbox",
    "gridColumn": 3
  }
]
